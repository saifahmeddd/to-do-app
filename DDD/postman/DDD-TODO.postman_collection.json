{
  "info": {
    "_postman_id": "7f0710e7-edd5-4b24-91e4-ddd70d0a1171",
    "name": "DDD TODO API - DDD authentication and tasks",
    "description": "Runs local registration and login, then applies the database-scoped JWT to owner-scoped task requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const explicitAuthRequests = ['Register current user', 'Login current user'];",
          "if (!explicitAuthRequests.includes(pm.info.requestName)) {",
          "const required = ['base_url', 'user_email', 'user_password'];",
          "const missing = required.filter(name => !pm.environment.get(name));",
          "if (missing.length) {",
          "  throw new Error(`Set these variables in the selected Postman environment: ${missing.join(', ')}`);",
          "}",
          "",
          "const baseUrl = pm.environment.get('base_url');",
          "const email = pm.environment.get('user_email');",
          "const password = pm.environment.get('user_password');",
          "",
          "pm.sendRequest({",
          "  url: `${baseUrl}/auth/login`,",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/json' },",
          "  body: {",
          "    mode: 'raw',",
          "    raw: JSON.stringify({ email, password })",
          "  }",
          "}, (error, response) => {",
          "  if (error) {",
          "    throw new Error(`Login request failed: ${error.message || error}`);",
          "  }",
          "",
          "  let data;",
          "  try { data = response.json(); } catch (_) { data = {}; }",
          "  if (response.code !== 200 || !data.access_token) {",
          "    const reason = data.error?.message || `${response.code} ${response.status}`;",
          "    throw new Error(`Login failed: ${reason}`);",
          "  }",
          "",
          "  pm.environment.set('access_token', data.access_token);",
          "  pm.environment.set('user_id', data.user_id || '');",
          "  pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${data.access_token}` });",
          "});",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1 - Authentication demonstration",
      "item": [
        {
          "name": "Register current user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('Local account registered', () => pm.response.to.have.status(201));",
                  "if (data.access_token) pm.environment.set('access_token', data.access_token);",
                  "if (data.user_id) pm.environment.set('user_id', data.user_id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Login current user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('Local account login succeeded', () => pm.response.to.have.status(200));",
                  "if (data.access_token) pm.environment.set('access_token', data.access_token);",
                  "if (data.user_id) pm.environment.set('user_id', data.user_id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "2 - Authorization and task CRUD",
      "item": [
    {
      "name": "Create task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Task created', () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "if (data.id) pm.environment.set('task_id', data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Learn Firebase Authentication\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/tasks"
      }
    },
    {
      "name": "List my tasks",
      "request": { "method": "GET", "header": [], "url": "{{base_url}}/tasks" }
    },
    {
      "name": "Get one task",
      "request": { "method": "GET", "header": [], "url": "{{base_url}}/tasks/{{task_id}}" }
    },
    {
      "name": "Rename task",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Understand Firebase Authentication\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/tasks/{{task_id}}"
      }
    },
    {
      "name": "Complete task",
      "request": { "method": "POST", "header": [], "url": "{{base_url}}/tasks/{{task_id}}/complete" }
    },
    {
      "name": "Delete task",
      "request": { "method": "DELETE", "header": [], "url": "{{base_url}}/tasks/{{task_id}}" }
    }
      ]
    }
  ]
}
