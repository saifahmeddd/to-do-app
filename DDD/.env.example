# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep this secret private and use the same value across backend instances.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRES_MINUTES=60
RESEND_API_KEY=re_xxxxxxxxx
REMINDER_FROM_EMAIL=tasks@your-verified-domain.com
WELCOME_FROM_EMAIL=onboarding@resend.dev

# Google OAuth Web client ID (same public client ID used by the frontend).
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# GitHub OAuth App credentials. Keep the secret in the backend only.
# GITHUB_CLIENT_ID=your-github-oauth-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# GITHUB_REDIRECT_URI=http://127.0.0.1:5173/

# Database used for both task storage and isolated user accounts.
# TASK_DATABASE=firestore
# TASK_DATABASE=mongodb
# TASK_DATABASE=postgres

# Optional overrides; uncomment only when needed. The local service account
# normally supplies the project ID.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_TASK_COLLECTION=tasks
# FIREBASE_USER_COLLECTION=users
# TODO_HOST=127.0.0.1
# TODO_PORT=8000
